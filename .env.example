# 本地开发可复制为 .env 并填写。纯 Docker Compose 时：镜像内已带默认 Key/库密码，
# 可不建 .env；若要覆盖，在此填写同名变量即可（compose 会用于变量替换）。
#
# ---------- 大模型：DeepSeek（OpenAI 兼容 Chat Completions API）----------
# LangChain 使用 ChatOpenAI 客户端连接此类接口，并非绑定 OpenAI 官方。
DEEPSEEK_API_KEY=sk-2de95d39c2ab435ba1d3bff22e7878ce
# 一般无需带 /v1，程序会自动拼接
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-chat

# ---------- 高德（路径、路况、天气等；未配置时天气可降级 Open-Meteo）----------
AMAP_API_KEY=
AMAP_BYPASS_PROXY=true
WEATHER_CACHE_TTL_SECONDS=600
# Redis 未配置或不可用时，天气缓存会自动退回进程内内存缓存
REDIS_URL=redis://127.0.0.1:6379/0
# 可选：如果接入独立 AQI / 气象预警代理接口，可在这里配置兼容 JSON API
# AMAP_AQI_API_URL=
# AMAP_WARNING_API_URL=

# ---------- GIS 行政区边界（天气区域解析优先走 GIS，再回退高德 geocode）----------
# 方式一：本地 GeoJSON，Feature properties 建议包含 adcode/name/province/city/district/level
# GIS_ADMIN_BOUNDARY_GEOJSON=/绝对路径/china_admin_boundaries.geojson
# 方式二：MySQL 空间表，字段约定见 weather_admin_boundary DDL
GIS_ENABLE_MYSQL=false
GIS_BOUNDARY_TABLE=weather_admin_boundary
GIS_ALIAS_TABLE=weather_admin_alias

# ---------- Memory + Planner（长期记忆与任务规划）----------
MEMORY_ENABLE_MYSQL=true
MEMORY_JSON_FALLBACK=data/memory_store.json
PLANNER_ENABLE=true
COGNITIVE_ENABLE=true

# ---------- MySQL（注册登录与会话）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_cs_agent
MYSQL_UNIX_SOCKET=/tmp/mysql.sock

# ---------- 埋点（tracking-system；详见 tracking-system/README.md）----------
# 不写则默认 mysql（写入 smart_cs_agent.tracking_events）
# TRACKING_STORAGE=csv
# TRACKING_CSV_PATH=/绝对路径/算法/tracking-system/data/events.csv
# TRACKING_STORAGE=csv_mysql
# TRACKING_STORAGE=jsonl

# ---------- 可选：其它 OpenAI 兼容厂商（仅当不使用 DeepSeek 时配置）----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- Docker Compose（docker compose up 时）----------
# 容器内 MySQL 的 root 密码；应用连接也使用该密码（与 MYSQL_PASSWORD 建议相同）
# MYSQL_ROOT_PASSWORD=
# APP_PORT=8010
# 是否把容器 3306 映射到本机（调试/外部客户端用，可省略）
# MYSQL_PUBLISH_PORT=3306
